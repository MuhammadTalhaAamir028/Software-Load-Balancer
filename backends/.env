# Single place for the capacity table of the four backends.
# DELAY_MS = artificial delay for GET / (milliseconds).
# CPUS     = CPU limit of the container (1.0 = one full core).
# The same values are copied by Talha into topo/clab.yml.
B1_DELAY_MS=5
B1_CPUS=1.0

B2_DELAY_MS=10
B2_CPUS=1.0

B3_DELAY_MS=25
B3_CPUS=0.5

B4_DELAY_MS=50
B4_CPUS=0.25