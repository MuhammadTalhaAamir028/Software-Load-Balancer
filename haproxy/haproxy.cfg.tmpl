global
    log stdout format raw local0 info
    maxconn 20000

defaults
    mode http
    log global
    option httplog
    option forwardfor
    option http-server-close
    retries 0
    # Do not add "option redispatch": failed requests must not move to another backend.
    timeout connect 2s
    timeout server 10s
    timeout http-keep-alive 15s
    timeout client 30s
    timeout http-request 10s
    timeout check 500ms

frontend fe
    bind :8080
    default_backend be

backend be
    balance ${ALGO}
    option httpchk
    http-check send meth GET uri /health ver HTTP/1.1 hdr Host lb
    http-check expect status 200
    default-server inter 1000 fall 3 rise 2
    server b1 10.0.3.11:8000 check
    server b2 10.0.3.12:8000 check
    server b3 10.0.3.13:8000 check
    server b4 10.0.3.14:8000 check

listen stats
    bind :8404
    stats enable
    stats uri /
    stats refresh 1s
